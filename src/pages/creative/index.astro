---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { natureLinks, site } from '../../lib/site';
---

<BaseLayout title={`${site.name} — Creative`} faceTitle="The Observer & Writer">
	<div class="mt-4 space-y-10">
		<p class="max-w-2xl text-[var(--ink-soft)]">
			Writing and field notes. Photography shortlist comes later.
		</p>

		<section class="space-y-3">
			<h2 class="text-sm font-medium uppercase tracking-[0.14em] text-[var(--muted)]">
				Writing
			</h2>
			<p class="text-sm text-[var(--muted)]">Substack / essays — link landing soon.</p>
		</section>

		<section class="space-y-3">
			<h2 class="text-sm font-medium uppercase tracking-[0.14em] text-[var(--muted)]">
				Nature logs
			</h2>
			<ul class="flex flex-wrap gap-x-5 gap-y-2">
				{
					natureLinks().map((link) => (
						<li>
							<a
								href={link.href}
								target="_blank"
								rel="noopener noreferrer"
								class="text-[var(--accent)] underline-offset-4 hover:underline"
							>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</section>
	</div>
</BaseLayout>
