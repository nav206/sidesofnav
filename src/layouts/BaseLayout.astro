---
import { ClientRouter } from 'astro:transitions';
import CubeStage from '../components/CubeStage';
import { FACES, isFacePath } from '../lib/faces';
import '../styles/global.css';
import '../styles/cube.css';

interface Props {
	title: string;
	faceTitle: string;
}

const { title, faceTitle } = Astro.props;
const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<ClientRouter fallback="swap" />
	</head>
	<body class="min-h-dvh bg-neutral-50 text-neutral-900 antialiased">
		<header class="relative z-20 border-b border-neutral-200 bg-neutral-50">
			<nav class="mx-auto flex max-w-5xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-4" aria-label="Cube faces">
				{
					FACES.map((face) => (
						<a
							href={face.path}
							aria-current={isFacePath(pathname, face.path) ? 'page' : undefined}
							class:list={[
								'text-sm tracking-wide transition-colors',
								isFacePath(pathname, face.path)
									? 'font-semibold text-neutral-900'
									: 'text-neutral-500 hover:text-neutral-800',
							]}
						>
							{face.navLabel}
						</a>
					))
				}
			</nav>
		</header>
		<main class="mx-auto max-w-5xl px-4 py-12" transition:animate="none">
			<CubeStage client:load pathname={pathname} faceTitle={faceTitle}>
				<slot />
			</CubeStage>
		</main>
		<script>
			// Flag in-app navigations so CubeStage can animate from the prior face
			// instead of spinning in on deep links / hard loads.
			document.addEventListener('astro:before-preparation', () => {
				try {
					sessionStorage.setItem('cube-nav', '1');
				} catch {
					/* private mode */
				}
			});
		</script>
	</body>
</html>
